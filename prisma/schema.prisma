generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  RECEIVE
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  COUNT_CORRECTION
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StocktakeStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum AssetStatus {
  IN_USE
  IN_STORAGE
  UNDER_REPAIR
  RETIRED
  LOST
}

model User {
  id                  String       @id @default(cuid())
  username            String       @unique @db.VarChar(80)
  email               String       @unique @db.VarChar(190)
  passwordHash        String       @db.VarChar(255)
  displayName         String       @db.VarChar(120)
  role                Role         @default(STAFF)
  status              UserStatus   @default(ACTIVE)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  movements           StockMovement[]
  auditLogs           AuditLog[]
  stocktakes          StocktakeSession[]
  assetEvents         AssetEvent[]
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique @db.VarChar(128)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  rememberMe Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(128)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}

model Category {
  id              String      @id @default(cuid())
  name            String      @db.VarChar(120)
  slug            String      @unique @db.VarChar(140)
  description     String?     @db.Text
  defaultReorder Int         @default(5)
  archivedAt      DateTime?
  parentId        String?
  parent          Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]  @relation("CategoryTree")
  products        Product[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@index([parentId])
}

model Product {
  id              String             @id @default(cuid())
  sku             String             @unique @db.VarChar(80)
  barcode         String?            @unique @db.VarChar(100)
  name            String             @db.VarChar(180)
  description     String?            @db.Text
  unitOfMeasure   String             @default("unit") @db.VarChar(30)
  costPrice       Decimal            @default(0) @db.Decimal(12, 2)
  sellPrice       Decimal            @default(0) @db.Decimal(12, 2)
  taxRate         Decimal            @default(0) @db.Decimal(5, 2)
  taxInclusive    Boolean            @default(false)
  reorderPoint    Int                @default(0)
  reorderQuantity Int                @default(0)
  imageUrl        String?            @db.VarChar(500)
  categoryId      String
  category        Category           @relation(fields: [categoryId], references: [id])
  parentId        String?
  parent          Product?           @relation("ProductVariants", fields: [parentId], references: [id])
  variants        Product[]         @relation("ProductVariants")
  priceTiers      ProductPriceTier[]
  suppliers       ProductSupplier[]
  attachments     ProductAttachment[]
  stockLevels     StockLevel[]
  movements       StockMovement[]
  purchaseLines   PurchaseOrderLine[]
  stocktakeCounts StocktakeCount[]
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@index([categoryId])
  @@index([parentId])
}

model ProductPriceTier {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(60)
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  @@unique([productId, name])
}

model ProductAttachment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName  String   @db.VarChar(255)
  filePath  String   @db.VarChar(500)
  mimeType  String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  @@index([productId])
}

model Supplier {
  id           String            @id @default(cuid())
  name         String            @db.VarChar(180)
  contactName  String?           @db.VarChar(120)
  email        String?           @db.VarChar(190)
  phone        String?           @db.VarChar(50)
  leadTimeDays Int               @default(0)
  archivedAt   DateTime?
  products     ProductSupplier[]
  orders       PurchaseOrder[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ProductSupplier {
  productId  String
  supplierId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku String? @db.VarChar(80)
  @@id([productId, supplierId])
}

model Warehouse {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(150)
  code        String          @unique @db.VarChar(30)
  address     String?         @db.Text
  archivedAt  DateTime?
  locations   Location[]
  stockLevels StockLevel[]
  movements   StockMovement[]
  orders      PurchaseOrder[]
  stocktakes  StocktakeSession[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Location {
  id          String        @id @default(cuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name        String        @db.VarChar(100)
  code        String        @db.VarChar(40)
  archivedAt  DateTime?
  stockLevels StockLevel[]
  movements   StockMovement[]
  assets      Asset[]
  assetEventsFrom AssetEvent[] @relation("AssetEventFromLocation")
  assetEventsTo   AssetEvent[] @relation("AssetEventToLocation")
  @@unique([warehouseId, code])
}

model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  locationId  String
  warehouseId String
  quantity    Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt
  @@unique([productId, locationId])
  @@index([warehouseId])
}

model StockMovement {
  id            String       @id @default(cuid())
  type          MovementType
  productId     String
  warehouseId   String
  locationId    String?
  userId        String
  quantity      Int
  quantityBefore Int
  quantityAfter Int
  reason        String?      @db.VarChar(255)
  reference     String?      @db.VarChar(120)
  salesReferenceId String?
  batchNumber   String?      @db.VarChar(100)
  expiryDate    DateTime?
  product       Product      @relation(fields: [productId], references: [id])
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  location      Location?    @relation(fields: [locationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  salesReference SalesReference? @relation(fields: [salesReferenceId], references: [id])
  createdAt     DateTime     @default(now())
  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([userId, createdAt])
  @@index([salesReferenceId])
}

model StocktakeSession {
  id          String           @id @default(cuid())
  name        String           @db.VarChar(150)
  status      StocktakeStatus  @default(OPEN)
  warehouseId String
  createdById String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy   User             @relation(fields: [createdById], references: [id])
  counts      StocktakeCount[]
  createdAt   DateTime         @default(now())
  completedAt DateTime?
}

model StocktakeCount {
  id            String          @id @default(cuid())
  sessionId     String
  productId     String
  systemQuantity Int
  countedQuantity Int?
  session       StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  @@unique([sessionId, productId])
}

model Asset {
  id           String       @id @default(cuid())
  tag          String       @unique @db.VarChar(100)
  name         String       @db.VarChar(180)
  description  String?      @db.Text
  serialNumber String?      @unique @db.VarChar(120)
  status       AssetStatus  @default(IN_STORAGE)
  ownerName    String?      @db.VarChar(150)
  locationId   String?
  location     Location?    @relation(fields: [locationId], references: [id])
  events       AssetEvent[]
  attachments  AssetAttachment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@index([locationId])
  @@index([status])
}

model AssetEvent {
  id             String    @id @default(cuid())
  assetId        String
  userId         String?
  type           String    @db.VarChar(50)
  details        String?   @db.Text
  fromLocationId String?
  toLocationId   String?
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromLocation   Location? @relation("AssetEventFromLocation", fields: [fromLocationId], references: [id])
  toLocation     Location? @relation("AssetEventToLocation", fields: [toLocationId], references: [id])
  createdAt      DateTime  @default(now())
  @@index([assetId, createdAt])
}

model AssetAttachment {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileName  String   @db.VarChar(255)
  filePath  String   @db.VarChar(500)
  mimeType  String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  @@index([assetId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  orderNumber String              @unique @db.VarChar(40)
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  notes      String?             @db.Text
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  warehouse  Warehouse           @relation(fields: [warehouseId], references: [id])
  lines      PurchaseOrderLine[]
  attachments PurchaseOrderAttachment[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  purchaseOrderId String
  productId   String
  orderedQty  Int
  receivedQty Int             @default(0)
  unitCost    Decimal         @db.Decimal(12, 2)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  @@unique([purchaseOrderId, productId])
}

model PurchaseOrderAttachment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  fileName        String        @db.VarChar(255)
  filePath        String        @db.VarChar(500)
  createdAt       DateTime      @default(now())
}

model SalesReference {
  id          String   @id @default(cuid())
  reference   String   @db.VarChar(120)
  customer    String?  @db.VarChar(150)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  movements  StockMovement[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(80)
  details   String?  @db.Text
  ipAddress String?  @db.VarChar(45)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
